// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

{
  // -------------------------------
  // Core behavior
  // -------------------------------
  "format_on_save": "off",
  "cli_default_open_behavior": "existing_window",
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "show_completions_on_input": true,
  "auto_indent_on_paste": true,
  "ensure_final_newline_on_save": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "tab_size": 2,
  "soft_wrap": "editor_width",
  "indent_guides": {
    "enabled": false
  },
  "vertical_scroll_margin": 9999.0,

  // -------------------------------
  // Styling / appearance (disabled via comments)
  // Uncomment any section you want to re-enable.
  // -------------------------------
  "show_whitespaces": "none",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 17.0,
  "buffer_font_size": 16.0,
  "mouse_wheel_zoom": false,
  "terminal": {
    "font_size": 20.0,
    "env": {
      "Q_NEW_SESSION": "\"1\""
    }
  },
  "gutter": {
    "folds": false
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false
    }
  },
  "hover_popover_enabled": false,
  "selection_highlight": false,
  "cursor_blink": false,
  "icon_theme": {
    "mode": "dark",
    "light": "JetBrains New UI Icons (Dark)",
    "dark": "JetBrains New UI Icons (Dark)"
  },

  // -------------------------------
  // Panels / layout
  // -------------------------------
  "tabs": {
    "git_status": false
  },
  "outline_panel": {
    "git_status": false,
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "git_status": false,
    "dock": "right"
  },
  "base_keymap": "JetBrains",

  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "play_sound_when_agent_done": "always",
    "notify_when_agent_waiting": "primary_screen",
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "skill": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": true
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },

  // -------------------------------
  // Language servers
  // -------------------------------
  "languages": {
    "PHP": {
      "language_servers": [
        "intelephense",
        "!phpactor",
        "!phptools",
        "!phpantom"
      ]
    }
  },
  "lsp": {
    "intelephense": {
      "settings": {
        "environment": {
          "includePaths": [
            "/Users/liamnguyen/Github/php-stubs"
          ],
          "phpVersion": "8.2.0"
        },
        "files": {
          "maxSize": 10000000
        }
      }
    },
    "solargraph": {
      "settings": {
        "use_bundler": false
      }
    }
  },

  // -------------------------------
  // Sticky + layout behavior
  // -------------------------------
  "sticky_scroll": {
    "enabled": false
  }
}
